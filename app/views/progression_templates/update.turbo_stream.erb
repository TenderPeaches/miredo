<% if @progression_template.valid? %>
    <%= turbo_stream.update dom_id(@progression_template) do %>
        <%= tag.legend "#{@index}) #{@progression_template.tag}" %>
        <%= render "progression_templates/form", progression_template: @progression_template %>
    <% end %>
<% else %>
    <%= flash_model_errors @progression_template %>
<% end %>