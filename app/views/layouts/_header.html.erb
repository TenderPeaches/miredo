<%# pull the header out of frame by default %>
<%= tag.header do %>
    <%= tag.nav id: "header-links", class: "header-links" do %>
        <%= render "layouts/header_links" %>
    <% end %>
    <%= turbo_link_to "⌃", header_links_path(show: true), id: "header-links-toggle", class: "header-links-toggle" %>
<% end %>
<%= render "layouts/header_tabs" %>