<%# session should be storing a boolean indicating whether or not the user expects to see the header links; if they are not to be seen, then the header is "pulled" out of frame %>
<%= tag.header class: "#{session[:show_header_links] ? "" : "pulled"} #{user_signed_in? ? "logged-in" : ""}" do %>
    <%= tag.nav id: "header-links", class: "header-links" do %>
        <%= render "layouts/header_links" %>
    <% end %>
    
    <%# the show parameter must be set to the opposite of the current setting, so that it acts as an on/off toggle %>
    <%= turbo_link_to "⌃", header_links_path(show: "#{session[:show_header_links] ? "false" : "true"}"), id: "header-links-toggle", class: "header-links-toggle" %>
<% end %>
<%= render "layouts/header_tabs" %>