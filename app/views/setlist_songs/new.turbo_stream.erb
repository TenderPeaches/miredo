<%= turbo_stream.replace "song-actions_#{@song_id}" do %>
    <%= model_form_for @setlist_song, class: "inline-form", id: "song-actions_#{@song_id}" do |form| %>
        <%= form.select :setlist, options_from_collection_for_select(@setlists, :id, :label) %>
        <%= form.hidden_field :song, value: @song_id %>
        <%= form.submit t("controls.add"), class: "button button--square" %>
    <% end %>
<% end %>