<%= tag.h1 t("content.my_account.title") %>

<%# contributors that aren't admin are assumed to be subscribed to a premium plan, which they can cancel from here %>
<% if current_user.is_contributor && !current_user.is_admin %>
    <%= tag.div class: "notice" do %>
        <% if current_user.subscription_active %>
            <%= tag.div t("content.my_account.subscription_active", date: current_user.subscribed_until) %>
            <%= turbo_link_to t("content.my_account.cancel_subscription"), subscription_path(id: current_user.id), method: :delete, confirm: t("content.my_account.cancel_subscription_confirm") %>
        <% else %>
            <%= tag.div t("content.my_account.subscription_inactive", date: current_user.subscribed_until) %>
            <%= link_button_to t("keywords.proceed"), new_subscription_path(checkout: :true) %>
        <% end %>
    <% end %>
<% end %>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "form" }) do |form| %>
    <%= render "users/shared/error_messages", resource: resource %>

    <%= tag.div class: "field" do %>
        <%= form.label :email %>
        <%= form.email_field :email, autofocus: true, autocomplete: User.human_attribute_name(:email) %>
    <% end %>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <%= tag.div t("auth.registration.awaiting_confirmation", for: @resource.unconfirmed_email) %>
    <% end %>

    <%= tag.div class: "field" do %>
        <%= form.label :username %>
        <%= form.text_field :username %>
    <% end %>

    <%= tag.div class: "field" do %>
        <%= form.label :password %>
        <%= tag.i "#{t("auth.registration.leave_blank")}" %>
        <%= form.password_field :password, autocomplete: "new-password" %>
        <% if @minimum_password_length %>
            <%= tag.div do %>
                <%= tag.em "(#{t("auth.minimum_password_characters", minimum: @minimum_password_length)})" %>
            <% end %>
        <% end %>
    <% end %>

    <%= tag.div class: "field" do %>
        <%= form.label :password_confirmation %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
    <% end %>

    <%= tag.div class: "field" do %>
        <%= form.label :current_password %> 
        <%= tag.i "#{t("auth.registration.need_password")}" %>
        <%= form.password_field :current_password, autocomplete: "current-password" %>
    <% end %>

    <%= tag.div class: "actions" do %>
        <%= form.submit t("keywords.update") %>
        <%= link_button_to t("auth.cancel.title"), registration_path(resource_name), data: { confirm: t("keywords.confirm"), turbo_confirm: t("keywords.confirm") }, method: :delete, class: "button--alert" %>
    <% end %>
<% end %>