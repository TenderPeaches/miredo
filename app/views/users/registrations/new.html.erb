<%= tag.h2 t('cta.sign_up') %>

<%= tag.div class: "notice" do %>
    <%= tag.h2 t("notices.sign_up.title") %>
    <%= tag.p t("notices.sign_up.blurb") %>
<% end %>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "form" }) do |f| %>

    <%= tag.div class: "field" do %>
        <%= f.label :email %><br />
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    <% end %>
    
    <%= tag.div class: "field" do %>
        <%= f.label :password %>
        <%= f.password_field :password, autocomplete: "new-password" %>
    <% end %>

    <%= tag.div class: "field" do %>
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    <% end %>
    <%= tag.div class: "actions" do %>
        <%= f.submit "Sign up" %>
        <%= link_to t('cta.log_in'), new_user_session_path, class: "button" %>
    <% end %>
<% end %>