<%= tag.h1 t('cta.sign_up') %>
<%= tag.p t("notices.sign_up.blurb"), class: "hint" %>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "form" }, data: { turbo: false }) do |form| %>

    <%= tag.div class: "field" do %>
        <%= form.label User.human_attribute_name(:email).humanize %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email" %>
    <% end %>
    
    <%= tag.div class: "field" do %>
        <%= form.label User.human_attribute_name(:password).humanize %>
        <%= form.password_field :password, autocomplete: "new-password" %>
    <% end %>

    <%= tag.div class: "field" do %>
        <%= form.label User.human_attribute_name(:password_confirmation).humanize %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
    <% end %>

    <%= tag.div class: "field" do %>
        <%= form.label "#{t("activerecord.attributes.user.username")} (#{t("keywords.optional")})" %>
        <%= form.text_field :username %>
    <% end %>

    <%= tag.div class: "actions" do %>
        <%= form.submit "Sign up" %>
        <%= link_to t('cta.log_in'), new_user_session_path, class: "button" %>
    <% end %>
<% end %>