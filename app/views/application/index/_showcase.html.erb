<%= tag.section class: "showcases" do %>
    <% songs.showcases.each do |showcase| %>
        <%= tag.fieldset class: "showcase#{user_signed_in? ? "" : " showcase--anon"}#{[:forgotten, :hot, :old_heart].include?(showcase.category) ? " showcase--hide-key" : ""}" do %>
            <% if user_signed_in? %>
                <%= tag.legend showcase.title %>
            <% else %>
                <%= tag.legend do %> 
                    <%= tag.span showcase.title %>
                    <%= link_to t("content.home_page.more_songs"), songs_path %>
                <% end %>
            <% end %>
            <% if showcase.songs.any? %>
                <%= tag.div class: "song-list" do %>
                    <%= render "songs/index/song_list_header", hide_key: showcase.category != :random %>
                    <% showcase.songs.each do |song| %>
                        <%= render song, hide_key: showcase.category != :random %>
                    <% end %>
                <% end %>
            <% else %>
                <% if showcase.category == :forgotten %>
                    <%= tag.div t("content.home_page.no_forgotten_songs"), class: "empty-list-text" %>
                <% elsif showcase.category == :hot %>
                    <%= tag.div t("content.home_page.no_hot_songs", times: current_user&.hot_plays_setting, days: current_user&.hot_days_setting), class: "empty-list-text" %>
                <% elsif showcase.category == :old_heart %>
                    <%= tag.div t("content.home_page.no_old_heart_songs", days: current_user&.old_heart_days_setting), class: "empty-list-text" %>
                <% end %>
            <% end %>
        <% end %>
    <% end %>
<% end %>