<%= tag.section class: "ctas hinted-list" do %>
    <% if user_signed_in? %>
        <%= cta_with_description t('cta.manage_setlists'), setlists_path, t('hints.manage_setlists') %>
        <%= cta_with_description t("content.statistics.title"), statistics_path, t("hints.statistics") %>
    <% else %>
        <%= cta_with_description t('cta.sign_up'), new_user_registration_path, t('hints.sign_up') %>
        <%= login_cta %>
    <% end %>
<% end %>