<%= tag.h1 t("content.statistics.title") %>

<%= tag.section id: "user-stats", class: "stats" do %>
    <%= tag.div class: "daily-average" do %>
        <%= tag.div "#{t("content.statistics.daily_plays")}:" %>
        <%= tag.div do %> 
            <%= tag.span "... #{t("content.statistics.weekly")}: " %><%= tag.span "%g" % "#{@stats.daily_plays_last_week}", class: "data" %>
        <% end %>
        <%= tag.div do %> 
            <%= tag.span "... #{t("content.statistics.monthly")}: " %><%= tag.span "%g" % "#{@stats.daily_plays_last_month}", class: "data" %>
        <% end %>
        <%= tag.div do %> 
            <%= tag.span "... #{t("content.statistics.yearly")}: " %><%= tag.span "%g" % "#{@stats.daily_plays_last_year}", class: "data" %>
        <% end %>
        <%= tag.div do %> 
            <%= tag.span "... #{t("content.statistics.all_time")}: " %><%= tag.span "%g" % "#{@stats.daily_plays_last_year}", class: "data" %>
        <% end %>
    <% end %>
    <%= tag.div class: "heart-stats" do %>
        <%= tag.div do %>
            <%= tag.span "#{t("content.statistics.distinct_songs_1")} " %>
            <%= tag.span @stats.distinct_songs_played, class: "data" %>
            <%= tag.span " #{t("content.statistics.distinct_songs_2")}" %>
        <% end %>
        <%= tag.div do %>
            <%= tag.span "#{t("content.statistics.distinct_songs_by_heart_1")} " %> 
            <%= tag.span @stats.distinct_songs_by_heart, class: "data" %> 
            <%= tag.span " #{t("content.statistics.distinct_songs_by_heart_2")}." %> 
        <% end %>
        <%= tag.div do %>
            <%= tag.span " #{t("content.statistics.percent_1")}" %>
            <%= tag.span "%g" % @stats.heart_ratio, class: "data" %><%= tag.span "#{t("content.statistics.percent_2")}" %>
        <% end %>
    <% end %>
<% end %>

<%= tag.section id: "calendar-stats" do %>
    <%= render "statistics/calendar", stats: @calendar_stats %>
<% end %>