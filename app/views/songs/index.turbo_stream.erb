<%# songs#index turbo_stream requests updates the song list and filter/sorting controls %>

<%# update the song list %>
<%= turbo_stream.update "songs" do %>
    <%= render "songs/index/song_list", songs: @songs, page_count: @page_count, expected_page: @expected_page %>
<% end %>

<%# replace the sort controls, as only single-column sort is supported; thus, reset the sort controls, then flag the one that needs to be updated with an indicator %>
<%= turbo_stream.replace "songs-sort-options" do %>
    <%= render "songs/index/sort_options", sort_control_id: @sort_control_id, sort_control_order: @sort_control_order %>
<% end %>