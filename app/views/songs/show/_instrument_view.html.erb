<%= tag.div id: "instruments", class: "instruments" do %>
    <%= form_tag instrument_views_path, data: { turbo: :true } do %>
        <%= hint_label :instrument_view %>
        <%= select_tag :instrument, options_from_collection_for_select(Instrument.order(id: :asc), :id, :name) %>
        <%= hidden_field_tag :tuning, instrument_view.tuning.id.to_s, id: "instrument-view-tuning" %>
        <%= hidden_field_tag :fret_count, instrument_view.fret_count, id: "instrument-view-fret-count" %>
        <%= hidden_field_tag :pitch_ids, instrument_view.pitch_ids.to_s %>
        <%= hidden_field_tag :capo, instrument_view.capo, id: "instrument-view-capo" %>
        <%= hidden_field_tag :song, song.id %>
        <%= hidden_field_tag :key, key.id %>
        <%= hidden_field_tag :scale, scale.id %>
        <%= submit_tag t('keywords.apply') %>
        <%= hidden_field_tag :format, :turbo_stream %>
        <%= tag.div class: "toggle-switch" do %>
            <%= tag.label t("content.show_song.capo_relative_pitches"), title: t("instructions.capo_relative_pitches") %>
            <%# as this toggle will call a new InstrumentView, it should hold all the current InstrumentView data so the controller can return the proper InstrumentView with the toggled setting adjusted, + the currently used key & scale in order to assess the proper pitch IDs %>
            <%= tag.label class: "toggle", data: { controller: "capo-relative-toggle", url: instrument_views_path, instrument_id: instrument_view.instrument.id, fret_count: instrument_view.fret_count, capo: instrument_view.capo, pitch_ids: instrument_view.pitch_ids.to_s, key_id: key.id, scale_id: scale.id, song_id: song.id } do %>
                <%= check_box_tag :capo_relative_pitches, checked: instrument_view.capo_relative_pitches || nil %>
                <%= tag.span class: "slider" %>
            <% end %>
        <% end %>
    <% end %>
    <%= tag.div id: "instrument-view", class: "instrument-view" do %>
        <%= instrument_print(instrument_view) %>
    <% end %>
<% end %>