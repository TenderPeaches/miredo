<%# helpful song info %>
<%= tag.div class: "song-info" do %>
    <%# user who submitted the song tab %>
    <%= tag.div do %>
        <%= tag.label "#{t('content.songs.submitter')}: " %>
        <%= tag.span song.submitter&.username || "Anon" %>
    <% end %>
    <%# original song key & scale %>
    <%= tag.div do %>
        <%= tag.label "#{t('content.songs.key')}: " %>
        <%= tag.span song.keyscale %>
    <% end %>
    <%# suggested capo %>
    <%= tag.div do %>
        <%= tag.label "#{t("content.songs.suggested_capo")}: " %>
        <%= tag.span song_capo_label song %>
    <% end %>
    <%# number of times practiced %>
    <% if current_user %>
        <%= tag.div do %>
            <%= tag.label "#{t("content.songs.nb_practice_user")}: " %>
            <%= tag.span do %>
                <%= tag.span song.plays(current_user), id: "user-play-count" %><%= tag.label "x" %>
            <% end %>
        <% end %>
    <% end %>
    <%# last played info %>
    <% if song.last_play current_user %>
        <%= tag.div do %>
            <%= tag.label "#{t("content.songs.last_played_short")}: " %>
            <%= tag.span song_last_played_label(song), id: "last-played" %>
        <% end %>
    <% end %>
<% end %>