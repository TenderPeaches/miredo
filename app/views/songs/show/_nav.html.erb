<%= tag.nav class: "nav-links" do %>
    <%# back to "songs" button %>
    <%= turbo_link_button t('controls.return'), songs_path, class: "button--square", title: t('controls.return_text') %>
    <%# random song button %>
    <%= turbo_link_button t('controls.random'), song_path(Song.random_id), class: "button--square", title: t('controls.random_text') %>
    <%# if there is a previous song %>
    <% if previous_song = song.previous %>
        <%# previous song button %>
        <%= turbo_link_button t('controls.previous'), song_path(previous_song.id), class: "button--square", title: t('controls.previous_text') %>
    <% end %>
    <% if next_song = song.next %>
        <%# next song button %>
        <%= turbo_link_button t('controls.next'), song_path(next_song.id), class: "button--square", title: t('controls.next_text') %>
    <% end %>
<% end %>