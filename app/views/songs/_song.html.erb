<%# about song--short; if user is signed out and the row is short, then the display will feel very empty because there is nothing past the name & artist name, so add the class that has a modified grid column template %>
<%= tag.div id: dom_id(song), class: "song #{song_row_color(song)}#{(local_assigns[:short_row] && !user_signed_in?) ? "song--short" : ""}" do %>
    <% if user_signed_in? %>
        <%= tag.span class: "songs-list__favorite" do %>
            <%= star_toggle(current_user.favorites.include?(song), new_song_user_favorite_path(song_id: song.id)) %>
        <% end %>
    <% end %>
    <%= tag.span class: "songs-list__title" do %>
        <%= link_to "#{song.name}", song_path(song.id) %>
    <% end %>
    <%= tag.span class: "songs-list__artist" do %>
        <% if current_user&.is_admin%>
            <%= link_to song.artist, edit_artist_path(song.artists.first) %>
        <% else %>
            <%= "#{song.artist}" %>
        <% end %>
    <% end %>
    <%# if a short_row local parameter was assigned, the row is expected to show less data than usual %>
    <% if local_assigns[:short_row] %>
        <%# 3 data columns are cut from the row, so 3 empty ones must be added in order to maintain the same grid layout %>
        <% 3.times do |i| %>
            <%= tag.span %>
        <% end %>
    <% else %>
        <%= tag.span class: "songs-list__capo" do %>
            <%= song.capo %>
        <% end %>
        <% if user_signed_in? %>
            <%= tag.span class: "songs-list__plays" do %>
                <%= song.plays current_user %>
            <% end %>
            <%= tag.span class: "songs-list__last-played" do %>
                <%= "#{song.last_played(current_user)&.strftime("%Y-%m-%d")}" %>
            <% end %>
        <% end %>
    <% end %>
    <% if user_signed_in? %>
        <%= render "songs/song_actions", song: song %>
    <% end %>
<% end %>